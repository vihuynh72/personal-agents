# Copy to .env and fill in. Ask Vi for values; never commit .env.

# LLMs: Claude = System 2 (planning, reasoning), Gemini = System 1 (fast parsing, routing)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=

# Web pulls for product data (F6)
BRIGHTDATA_API_KEY=
BRIGHTDATA_BROWSER_WSS=
BRIGHTDATA_UNLOCKER_ZONE=

# Memory (F2, F11)
COGNEE_URL=
COGNEE_API_KEY=

# Data integration
AIRBYTE_URL=http://localhost:8000
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=

# Texting (F3)
PHOTON_PROJECT_ID=

# Voice (demo video)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Stripe: TEST keys only (sk_test_ / pk_test_)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Context layer (F6, F10)
SENSO_API_KEY=

# Day 0 Google connect (read-only Gmail + Calendar). Feature is off unless both are set.
# Register redirect URI: <PUBLIC_URL>/connect/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=https://personal-agents-production-81468651.up.railway.app

# Cloud ordering (F13). Set CLOUD_ORDERING=1 to enable; STORE_BASE_URL defaults to the demo store on PUBLIC_URL.
CLOUD_ORDERING=
STORE_BASE_URL=

# Identity and age verification (sandbox key)
PERSONA_API_KEY=
