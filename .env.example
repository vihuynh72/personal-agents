BRIGHTDATA_UNLOCKER_ZONE=

# Memory (F2, F11)
COGNEE_URL=
COGNEE_API_KEY=

# Data integration
AIRBYTE_URL=http://localhost:8000
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=

# Texting (F3)
PHOTON_PROJECT_ID=

# Voice (demo video)
